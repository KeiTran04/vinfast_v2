-- không qua bảng raw_* trung gian trong ClickHouse).
-- Biểu thức glob */data.parquet phủ mọi phân vùng ngày (batch_date key).
select
    vehicle_id,
    event_timestamp,
    model,
    type,
    battery_soc_pct,
    battery_soh_pct,
    battery_temp_c,
    battery_temp_avg_c,
    battery_temp_max_c,
    charging_status,
    speed_kmh,
