left join s3('http://minio:9000/vinfast-silver/entities/users/data.parquet', 'vinfast', 'vinfast123', 'Parquet', 'u_id String, name String, phone String') as u
    on v.u_id = u.u_id
where v.vehicle_id IS NOT NULL
    
  )
      
      
